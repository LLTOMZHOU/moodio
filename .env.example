# Copy this file to .env and fill in local values.
# .env is ignored by git and is meant to override any shell-wide keys.

# OpenRouter-backed model path. OPENAI_API_KEY is kept empty so local loaders can
# explicitly choose OPENROUTER_API_KEY instead of accidentally using a global key.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-5.4-mini
MOODIO_AGENT_TIMEOUT_SECONDS=45
# Where the durable Station snapshot, JSONL feed/conversation, agent session,
# and materialized listener signals live. Relative paths are from the repo root.
MOODIO_DATA_DIR=var/data

# ElevenLabs TTS path. Fill in ELEVENLABS_API_KEY only.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# OpenRouter-backed TTS path. Uses the same OPENROUTER_API_KEY above.
OPENROUTER_TTS_MODEL=openai/gpt-4o-mini-tts-2025-12-15
OPENROUTER_TTS_VOICE=alloy
OPENROUTER_TTS_RESPONSE_FORMAT=mp3

# Direct OpenAI Speech API fallback for STT or if OpenRouter TTS is disabled.
OPENAI_AUDIO_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=cedar
OPENAI_TTS_RESPONSE_FORMAT=mp3
OPENAI_STT_MODEL=gpt-4o-mini-transcribe

# Optional SoundCloud API path. Not required for SoundCloud embeds.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_OAUTH_TOKEN=

# Optional MiniMax generation path for future station IDs/interludes.
MINIMAX_API_KEY=
